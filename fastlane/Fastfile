default_platform(:ios)

ROOT_DIR = File.expand_path("..", __dir__)
IOS_DIR = File.join(ROOT_DIR, "ios")
ANDROID_DIR = File.join(ROOT_DIR, "android")
IOS_IPA = File.join(IOS_DIR, "build/export/pray.bh.ipa")
ANDROID_AAB = File.join(ANDROID_DIR, "app/build/outputs/bundle/release/app-release.aab")

private_lane :asc_api_key do
  key_id = ENV["ASC_KEY_ID"]
  issuer_id = ENV["ASC_ISSUER_ID"]
  key_filepath = ENV["ASC_KEY_PATH"]
  key_content = ENV["ASC_KEY_CONTENT"]

  UI.user_error!("Set ASC_KEY_ID environment variable") unless key_id && !key_id.empty?
  UI.user_error!("Set ASC_ISSUER_ID environment variable") unless issuer_id && !issuer_id.empty?
  UI.user_error!("Set ASC_KEY_PATH or ASC_KEY_CONTENT environment variable") unless (key_filepath && !key_filepath.empty?) || (key_content && !key_content.empty?)

  params = {
    key_id: key_id,
    issuer_id: issuer_id,
    duration: 1200,
    in_house: false
  }

  if key_content && !key_content.empty?
    params[:key_content] = key_content
  else
    params[:key_filepath] = File.expand_path(key_filepath, ROOT_DIR)
  end

  app_store_connect_api_key(params)
end

platform :ios do
  desc "Build signed IPA and upload to TestFlight"
  lane :beta do
    sh("cd '#{IOS_DIR}' && xcodebuild -project PrayBH.xcodeproj -scheme PrayBH -configuration Release -sdk iphoneos -archivePath build/archives/PrayBH.xcarchive archive")
    sh("cd '#{IOS_DIR}' && rm -rf build/export && xcodebuild -exportArchive -archivePath build/archives/PrayBH.xcarchive -exportPath build/export -exportOptionsPlist ExportOptions.app-store.plist")
    api_key = asc_api_key
    upload_to_testflight(
      api_key: api_key,
      app_identifier: "bh.pray.app",
      ipa: IOS_IPA,
      skip_waiting_for_build_processing: true,
      changelog: ENV["RELEASE_NOTES"] || "Latest release update."
    )
  end

  desc "Upload already-built IPA to TestFlight"
  lane :upload do
    api_key = asc_api_key
    upload_to_testflight(
      api_key: api_key,
      app_identifier: "bh.pray.app",
      ipa: IOS_IPA,
      skip_waiting_for_build_processing: true,
      changelog: ENV["RELEASE_NOTES"] || "Latest release update."
    )
  end

  desc "Verify App Store Connect connection"
  lane :verify_asc do
    api_key = asc_api_key
    build_num = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "bh.pray.app"
    )
    UI.success("App Store Connect authentication successful! Latest TestFlight build number: #{build_num}")
  end
end

platform :android do
  desc "Build signed AAB and upload to Play internal testing"
  lane :internal do
    java_home = ENV["JAVA_HOME"]
    if java_home.nil? || java_home.empty?
      default_mac_jbr = "/Applications/Android Studio.app/Contents/jbr/Contents/Home"
      java_home = default_mac_jbr if File.directory?(default_mac_jbr)
    end

    env_prefix = java_home ? "JAVA_HOME='#{java_home}' " : ""
    sh("cd '#{ANDROID_DIR}' && #{env_prefix}./gradlew :app:bundleRelease")

    json_key_path = ENV["GOOGLE_PLAY_JSON_KEY"] || File.join(ROOT_DIR, "fastlane/google-play-service-account.json")
    json_key_path = File.expand_path(json_key_path, ROOT_DIR)

    upload_to_play_store(
      aab: ANDROID_AAB,
      package_name: "bh.pray.app",
      json_key: json_key_path,
      track: ENV["PLAY_TRACK"] || "internal",
      release_status: ENV["PLAY_RELEASE_STATUS"] || "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload already-built AAB to Play internal testing"
  lane :upload do
    json_key_path = ENV["GOOGLE_PLAY_JSON_KEY"] || File.join(ROOT_DIR, "fastlane/google-play-service-account.json")
    json_key_path = File.expand_path(json_key_path, ROOT_DIR)

    upload_to_play_store(
      aab: ANDROID_AAB,
      package_name: "bh.pray.app",
      json_key: json_key_path,
      track: ENV["PLAY_TRACK"] || "internal",
      release_status: ENV["PLAY_RELEASE_STATUS"] || "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
