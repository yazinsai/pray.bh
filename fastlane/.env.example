# Fastlane Environment Variables Example
# Copy to fastlane/.env or set in your environment / CI secrets

# App Store Connect API Key (for TestFlight deployment)
ASC_KEY_ID="YOUR_KEY_ID"
ASC_ISSUER_ID="YOUR_ISSUER_ID"
# Provide EITHER ASC_KEY_PATH (path to AuthKey_XXXX.p8 file) OR ASC_KEY_CONTENT (p8 key content)
ASC_KEY_PATH="/path/to/AuthKey_XXXX.p8"
# ASC_KEY_CONTENT="-----BEGIN PRIVATE KEY-----\n..."

APPLE_ID="your-apple-id@example.com"
APPLE_TEAM_ID="88M2R3XJZH"
RELEASE_NOTES="Bug fixes and performance improvements."

# Google Play Service Account (for Play Store deployment)
# Path to Google Play service account JSON key file or JSON content string
GOOGLE_PLAY_JSON_KEY="/path/to/google-play-service-account.json"
PLAY_TRACK="internal" # Options: internal, alpha, beta, production
PLAY_RELEASE_STATUS="completed" # Options: completed, draft, inProgress, halted
